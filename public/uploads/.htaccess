# Deny direct execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|sh|bash|py|rb|exe|jsp|asp|aspx)$">
    Order Deny,Allow
    Deny from all
    Require all denied
</FilesMatch>

# Disable PHP engine if mod_php is used
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Disable directory browsing
Options -Indexes
